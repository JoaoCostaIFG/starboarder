# Required
# The public origin of your Fluxer instance.
INSTANCE_URL=https://chat.example.com

# Bot token (<application_id>.<secret>), shown once when the application is created.
BOT_TOKEN=

# Optional — defaults shown

# Channel (name, case-insensitive, or a raw channel ID) that receives starboard posts.
STARBOARD_CHANNEL_NAME=starboard

# Unicode emoji that triggers the starboard. For a custom guild emoji use "name:id".
STAR_EMOJI=⭐

# Stars required before a message is posted (must be a positive integer).
THRESHOLD=1

# Base URL for jump links; defaults to INSTANCE_URL. Only change it if the web
# app is served from a different origin than the one you use for the API.
WEB_APP_BASE_URL=

# Direct routing overrides for same-server Docker deployments. When BOTH are set,
# instance discovery is skipped and the bot talks to the containers directly:
#   API_URL=http://api:8080
#   GATEWAY_URL=ws://gateway:8080
# (Requires the bot to be attached to the Fluxer compose network — see README.)
API_URL=
GATEWAY_URL=

# Directory for the persistent dedup store (mounted as a volume in Docker).
DATA_DIR=data

# Log level: debug | info | warn | error
LOG_LEVEL=info
